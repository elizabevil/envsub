{
  "types": {
    "string_type_root": ${string_type_root | toJson},
    "int_type_materialized": ${int_type_materialized | type int},
    "float_type_literal_kept": ${float_type_literal_kept},
    "bool_type_dotenv": ${bool_type_dotenv | type bool},
    "array_type_json_joined": ${array_type_json_joined | type array<string> | toJson},
    "object_type_yaml_sorted": ${object_type_yaml_sorted | type object | toJson},
    "null_type_preserved": ${null_type_preserved | type null | toJson}
  },
  "sources": {
    "string_src_from_default": ${string_src_from_default | toJson},
    "string_src_from_values": ${string_src_from_values | toJson},
    "string_src_from_dotenv": ${string_src_from_dotenv | toJson},
    "string_src_from_set": ${string_src_from_set | toJson}
  },
  "precedence": {
    "string_prec_dotenv_over_values": ${string_prec_dotenv_over_values | toJson},
    "string_prec_set_over_dotenv": ${string_prec_set_over_dotenv | toJson},
    "string_prec_setjson_over_set": ${string_prec_setjson_over_set | toJson},
    "string_prec_default_never_wins": ${string_prec_default_never_wins | toJson}
  },
  "process": {
    "string_process_explicit": "${@process.ENVSUB_STRING-${string_process_explicit}}",
    "string_process_bare_miss": "${ENVSUB_STRING-fell-through}",
    "string_process_special": ${@process["ENVSUB-DASHED"]-absent | toJson},
    "int_process_materialized": ${@process.ENVSUB_INT | type int},
    "bool_process_materialized": ${@process.ENVSUB_BOOL | type bool}
  },
  "positions": {
    "top_level": ${string_type_root | toJson},
    "nested": {
      "inner": ${string_type_root | toJson},
      "in_array": [${string_type_root | toJson}, ${string_type_root | toJson}],
      "default_word": "${string_operator_missing:-${string_type_root}}",
      "formatter_arg": ${array_type_json_joined | join "${string_type_root}" | toJson}
    }
  },
  "operators": {
    "direct": ${string_operator_present | toJson},
    "default_colon": ${string_operator_missing:-fallback | toJson},
    "default_dash": ${string_operator_missing-fallback | toJson},
    "alternate_colon": ${string_operator_present:+alt | toJson},
    "alternate_plus": ${string_operator_falsy_zero+alt | toJson},
    "assign_colon": ${string_operator_assigned:=written | toJson},
    "assign_visible": ${string_operator_assigned | toJson},
    "assign_no_overwrite": ${string_operator_present=ignored | toJson},
    "default_no_write": ${string_operator_empty:-not-written | toJson},
    "default_no_write_visible": ${string_operator_empty | toJson},
    "escape_dollar": "$$NAME",
    "positional": "$1"
  },
  "schema": {
    "int_schema_from_string": ${int_schema_from_string | type int},
    "bool_schema_from_string": ${bool_schema_from_string | type bool},
    "string_schema_enum_ok": ${string_schema_enum_ok | toJson},
    "array_schema_min_items": ${array_schema_min_items | type array<string> | toJson}
  },
  "pipeline": {
    "join_default": ${array_type_json_joined | type array<string> | join | toJson},
    "join_custom": ${array_type_json_joined | type array<string> | join "," | toJson},
    "type_then_json": ${array_type_json_joined | type array<string> | toJson},
    "json_of_yaml": ${object_type_yaml_sorted | type object | toYaml | toJson},
    "chained": ${array_type_json_joined | type array<string> | join "-" | indent 0 | toJson},
    "quoted_scalar": ${string_fmt_quotes | quote | toJson}
  }
}
